# Copy to .env.local and fill in your own test-mode values.
# These are server-side only: never prefix them with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
APP_URL=http://localhost:3000

# Voucherify Sandbox, Loyalty v2 (loyalty points are the source of truth there).
VOUCHERIFY_APP_ID=app_replace_me
VOUCHERIFY_SECRET_KEY=key_replace_me
VOUCHERIFY_LOYALTY_PROGRAM_ID=lprg_replace_me
# Optional: the point wallet to use if the program has several.
# VOUCHERIFY_LOYALTY_CARD_DEFINITION_ID=lcdef_replace_me
VOUCHERIFY_API_URL=https://api.voucherify.io

# Resend test mode (ticket emails).
RESEND_API_KEY=re_replace_me
RESEND_FROM=onboarding@resend.dev
